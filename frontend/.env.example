# Frontend Environment Configuration

# Base Backend API URL (for production build / dev proxy)
VITE_API_URL=/api

# Real-time WebSocket Stream URL (Optional, defaults to auto-detecting host on port 8000)
# VITE_WS_URL=ws://localhost:8000/ws/parking

# Maps Integration
VITE_GOOGLE_MAPS_API_KEY=mock_google_maps_api_key

# IoT Simulation Mode
VITE_DEMO_MODE=true
