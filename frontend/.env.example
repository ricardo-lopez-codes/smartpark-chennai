# Frontend Environment Configuration

# Base Backend API URL (Specify your deployed Render backend base URL)
VITE_API_URL=https://smartpark-api-h4dn.onrender.com

# Real-time WebSocket Stream URL (Optional, auto-derived from VITE_API_URL if omitted)
# VITE_WS_URL=wss://smartpark-api-h4dn.onrender.com/ws/parking

# Maps Integration
VITE_GOOGLE_MAPS_API_KEY=mock_google_maps_api_key

# Hardware Simulation Mode
VITE_DEMO_MODE=true
