# Backend Environment Configuration

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./smartpark.db
# Example PostgreSQL URL: postgresql://username:password@localhost:5432/smartpark

# JWT Security
JWT_SECRET=supersecretjwtkeyforsmartparkchennai2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Payment Integration (Razorpay Mock / Sandbox)
RAZORPAY_KEY_ID=rzp_test_mockkey123
RAZORPAY_KEY_SECRET=rzp_test_mocksecret123

# Maps & Navigation API
GOOGLE_MAPS_API_KEY=mock_google_maps_api_key

# Hardware & IoT Demo Mode
DEMO_MODE=true

# Allowed CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
